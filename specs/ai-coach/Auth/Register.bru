meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users/register/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "athlete@example.com",
    "password": "strong-password",
    "display_name": "Athlete Name"
  }
}

script:post-response {
  const body = res.getBody();

  if (body.access) {
    bru.setEnvVar("accessToken", body.access);
  }

  if (body.refresh) {
    bru.setEnvVar("refreshToken", body.refresh);
  }

  if (body.user?.id) {
    bru.setEnvVar("userId", body.user.id);
  }
}
