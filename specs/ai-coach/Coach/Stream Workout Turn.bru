meta {
  name: Stream Workout Turn
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/coach/turns/stream/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: text/event-stream
}

body:json {
  {
    "page_context": {
      "page_type": "workout",
      "context_id": "{{workoutId}}"
    },
    "message": "What should I adjust in this workout based on my recent recovery?"
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
