meta {
  name: Create Workout Exercise
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/workout-exercises/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workout": "{{workoutId}}",
    "exercise": "{{exerciseId}}",
    "sets": 4,
    "reps": 8,
    "time": 15,
    "effort": "hard",
    "note": "Move well."
  }
}
