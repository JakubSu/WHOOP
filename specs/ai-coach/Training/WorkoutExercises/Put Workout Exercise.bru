meta {
  name: Put Workout Exercise
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/workout-exercises/{{workoutExerciseId}}/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workout": "{{workoutId}}",
    "exercise": "{{exerciseId}}",
    "sets": 4,
    "reps": 8,
    "time": 15,
    "effort": "hard",
    "note": "Move well."
  }
}
