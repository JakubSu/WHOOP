{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: Run ASGI Server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/services/api",
      "args": [
        "config.asgi:application",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "justMyCode": true,
      "env": {
        "DJANGO_SETTINGS_MODULE": "config.settings",
        "PYTHONPATH": "${workspaceFolder}/services/api"
      }
    },
    {
      "name": "Web: Launch React App",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/apps/web",
      "preLaunchTask": "Web: Run Vite"
    }
  ]
}
