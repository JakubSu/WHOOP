{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: Run Server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/services/api/manage.py",
      "cwd": "${workspaceFolder}/services/api",
      "args": ["runserver", "127.0.0.1:8000"],
      "django": true,
      "justMyCode": true,
      "env": {
        "DJANGO_SETTINGS_MODULE": "config.settings",
        "PYTHONPATH": "${workspaceFolder}/services/api"
      }
    },
    {
      "name": "Web: Launch React App",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/apps/web",
      "preLaunchTask": "Web: Run Vite"
    },
    {
      "name": "Java API: Run Spring Boot",
      "type": "java",
      "request": "launch",
      "mainClass": "com.jakubsuran.aicoachapi.AicoachApiApplication",
      "projectName": "aicoach-api",
      "cwd": "${workspaceFolder}/services/aicoach-api",
      "args": "--spring.profiles.active=local",
      "preLaunchTask": "Java API: Start Local Postgres",
      "postDebugTask": "Java API: Stop Local Postgres",
      "env": {
        "SPRING_PROFILES_ACTIVE": "local"
      }
    }
  ]
}
