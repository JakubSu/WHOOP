{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "API: Run Server",
      "type": "process",
      "command": "C:\\Users\\kubas\\miniconda3\\envs\\whoop-api\\python.exe",
      "args": [
        "manage.py",
        "runserver",
        "127.0.0.1:8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}/services/api",
        "env": {
          "DJANGO_SETTINGS_MODULE": "config.settings",
          "PYTHONPATH": "${workspaceFolder}/services/api"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "API: Migrate",
      "type": "process",
      "command": "C:\\Users\\kubas\\miniconda3\\envs\\whoop-api\\python.exe",
      "args": [
        "manage.py",
        "migrate"
      ],
      "options": {
        "cwd": "${workspaceFolder}/services/api",
        "env": {
          "DJANGO_SETTINGS_MODULE": "config.settings",
          "PYTHONPATH": "${workspaceFolder}/services/api"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "API: Test",
      "type": "process",
      "command": "C:\\Users\\kubas\\miniconda3\\envs\\whoop-api\\python.exe",
      "args": [
        "manage.py",
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}/services/api",
        "env": {
          "DJANGO_SETTINGS_MODULE": "config.settings",
          "PYTHONPATH": "${workspaceFolder}/services/api"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Web: Run Vite",
      "type": "npm",
      "script": "dev",
      "path": "apps/web",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local:\\s+http://localhost:5173/"
        }
      }
    },
    {
      "label": "Java API: Start Local Postgres",
      "type": "shell",
      "command": "docker compose -f services/aicoach-api/compose.local.yml up -d aicoach-api-db",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Java API: Run Spring Boot",
      "type": "shell",
      "command": ".\\mvnw.cmd spring-boot:run -Dspring-boot.run.profiles=local",
      "options": {
        "cwd": "${workspaceFolder}/services/aicoach-api"
      },
      "dependsOn": "Java API: Start Local Postgres",
      "problemMatcher": []
    },
    {
      "label": "Java API: Test",
      "type": "shell",
      "command": ".\\mvnw.cmd test",
      "options": {
        "cwd": "${workspaceFolder}/services/aicoach-api"
      },
      "problemMatcher": []
    },
    {
      "label": "Java API: Stop Local Postgres",
      "type": "shell",
      "command": "docker compose -f services/aicoach-api/compose.local.yml down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
