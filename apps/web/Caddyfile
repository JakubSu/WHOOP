{
	email {$CADDY_ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	root * /srv

	handle /api/* {
		reverse_proxy api:8000 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle /admin/* {
		reverse_proxy api:8000 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
