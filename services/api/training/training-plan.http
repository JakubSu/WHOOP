@baseUrl = http://127.0.0.1:8000/api/v1
@trainingPlanId = 11111111-1111-1111-1111-111111111111

### List training plans
GET {{baseUrl}}/training-plans/

### Create training plan
POST {{baseUrl}}/training-plans/
Content-Type: application/json

{
  "name": "Strength Block",
  "start_date": "2026-06-01",
  "end_date": "2026-07-27"
}

### Get training plan
GET {{baseUrl}}/training-plans/{{trainingPlanId}}/

### List workouts for training plan
GET {{baseUrl}}/training-plans/{{trainingPlanId}}/workouts/

### Update training plan
PATCH {{baseUrl}}/training-plans/{{trainingPlanId}}/
Content-Type: application/json

{
  "end_date": "2026-08-03"
}

### Delete training plan
DELETE {{baseUrl}}/training-plans/{{trainingPlanId}}/
