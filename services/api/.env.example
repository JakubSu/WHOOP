SECRET_KEY=dev-only-secret-key-for-whoop-api-local-jwt-signing-2026
DJANGO_ENV=local
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
WHOOP_CLIENT_ID=your-whoop-client-id
WHOOP_CLIENT_SECRET=your-whoop-client-secret
WHOOP_REDIRECT_URI=http://127.0.0.1:8000/api/v1/whoop/callback/
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WHOOP_TOKEN_ENCRYPTION_KEY=replace-with-generated-fernet-key
WHOOP_FRONTEND_SUCCESS_URL=http://localhost:5173/connect-whoop/success
WHOOP_FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WHOOP_ALLOWED_USER_EMAILS=friend1@example.com,friend2@example.com
WHOOP_OAUTH_STATE_TTL_SECONDS=600
JWT_REFRESH_COOKIE_NAME=whoop_refresh
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAMESITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

AI_LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna
# Select the real Pydantic AI runner only after OPENAI_API_KEY is configured.
# COACH_RUNNER_FACTORY=ai.implementations.pydantic_coach.create_pydantic_coach_runner
# Optional deterministic runner for exercising real coach tools without an LLM.
# COACH_RUNNER_FACTORY=ai.implementations.scenario.create_scenario_runner
COACH_RUN_TIMEOUT_SECONDS=45
COACH_CONTEXT_RECENT_TURNS=3
COACH_CONTEXT_TOKEN_RESERVE=4000
COACH_MAX_MODEL_REQUESTS=6
COACH_MAX_TOOL_CALLS=12
COACH_MAX_INPUT_TOKENS=40000
COACH_MAX_OUTPUT_TOKENS=4000
COACH_MAX_INPUT_TOKENS_PER_REQUEST=12000
COACH_TOOL_TIMEOUT_SECONDS=10
COACH_STREAM_KEEPALIVE_SECONDS=15
COACH_MAX_COST_USD=0.05
COACH_USER_MONTHLY_BUDGET_USD=2.00
COACH_GLOBAL_MONTHLY_BUDGET_USD=20.00
COACH_LOGFIRE_ENABLED=false
# Set to true only in a trusted development environment. This captures prompts,
# assistant responses, and tool arguments/results in Logfire.
COACH_LOGFIRE_CAPTURE_CONTENT=false
# Capture image/audio/file payloads as well. Normally leave this disabled.
COACH_LOGFIRE_CAPTURE_BINARY_CONTENT=false
# Capture provider request parameters. Normally leave this disabled.
COACH_LOGFIRE_CAPTURE_MODEL_REQUEST_PARAMETERS=false
LOGFIRE_SERVICE_NAME=whoop-coach
LOGFIRE_ENVIRONMENT=local
# LOGFIRE_TOKEN=your-logfire-write-token
LOG_LEVEL=INFO
LOG_LLM_PAYLOADS=false

# Production Docker/EC2 settings. The deployment process injects production
# secrets from SSM before starting the API container; Django does not fetch SSM.
# APP_DOMAIN is required by the production settings module.
APP_DOMAIN=app.example.com
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=whoop_ai_coach
POSTGRES_USER=whoop_ai_coach
