SECRET_KEY=dev-only-secret-key-for-whoop-api-local-jwt-signing-2026
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
WHOOP_CLIENT_ID=your-whoop-client-id
WHOOP_CLIENT_SECRET=your-whoop-client-secret
WHOOP_REDIRECT_URI=http://127.0.0.1:8000/api/v1/whoop/callback/
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WHOOP_TOKEN_ENCRYPTION_KEY=replace-with-generated-fernet-key
WHOOP_FRONTEND_SUCCESS_URL=http://localhost:5173/connect-whoop/success
WHOOP_FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WHOOP_OAUTH_STATE_TTL_SECONDS=600
JWT_REFRESH_COOKIE_NAME=whoop_refresh
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAMESITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

AI_LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT=30
# Optional deterministic runner for exercising real coach tools without an LLM.
# COACH_RUNNER_FACTORY=ai.implementations.scenario.create_scenario_runner
LOG_LEVEL=INFO
LOG_LLM_PAYLOADS=false

# Production Docker/EC2 settings. Use these only for production-style runs.
# In production, secrets are loaded from SSM Parameter Store when DEBUG=false.
AWS_REGION=us-east-1
SSM_PARAMETER_PREFIX=/whoop-ai-coach/prod
# DJANGO_ALLOWED_HOSTS overrides ALLOWED_HOSTS when set.
# DJANGO_ALLOWED_HOSTS=example.com
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=whoop_ai_coach
POSTGRES_USER=whoop_ai_coach
