#!/bin/bash
set -euo pipefail

APP_DIRECTORY="${app_directory}"
APP_USER="${django_user}"
ENV_FILE="${app_directory}/.env"

if ! id -u "$APP_USER" >/dev/null 2>&1; then
  useradd --system --home-dir "$APP_DIRECTORY" --shell /usr/sbin/nologin "$APP_USER"
fi

mkdir -p "$APP_DIRECTORY"
chown "$APP_USER:$APP_USER" "$APP_DIRECTORY"

OPENAI_API_KEY="$(printf '%s' '${openai_api_key_b64}' | base64 --decode)"

{
  printf 'AI_LLM_PROVIDER=%s\n' 'openai'
  printf 'OPENAI_API_KEY=%s\n' "$OPENAI_API_KEY"
  printf 'OPENAI_MODEL=%s\n' '${openai_model}'
  printf 'CORS_ALLOWED_ORIGINS=%s\n' '${cors_allowed_origins}'
  printf 'WHOOP_FRONTEND_ALLOWED_ORIGINS=%s\n' '${whoop_frontend_allowed_origins}'
  printf 'WHOOP_FRONTEND_SUCCESS_URL=%s\n' '${whoop_frontend_success_url}'
} >"$ENV_FILE"

chown "$APP_USER:$APP_USER" "$ENV_FILE"
chmod 600 "$ENV_FILE"
