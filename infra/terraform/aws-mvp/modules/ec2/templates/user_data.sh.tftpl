#!/bin/bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

APP_DIRECTORY="${app_directory}"
AWS_REGION="${aws_region}"
CLOUDWATCH_HOST_LOG_GROUP="${cloudwatch_host_log_group_name}"
DEPLOY_LOG_DIR="/var/log/whoop-ai-coach"

apt-get update
apt-get install -y curl docker.io docker-compose-v2 git unzip

if ! command -v aws >/dev/null 2>&1; then
  tmp_dir="$(mktemp -d)"
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "$tmp_dir/awscliv2.zip"
  unzip -q "$tmp_dir/awscliv2.zip" -d "$tmp_dir"
  "$tmp_dir/aws/install" --update
  rm -rf "$tmp_dir"
fi

systemctl enable --now docker

mkdir -p "$DEPLOY_LOG_DIR"
touch "$DEPLOY_LOG_DIR/deploy.log" /var/log/docker.log
chmod 640 "$DEPLOY_LOG_DIR/deploy.log" /var/log/docker.log

cat >/etc/systemd/system/whoop-docker-daemon-log.service <<'EOF'
[Unit]
Description=Mirror Docker daemon journal to /var/log/docker.log
After=docker.service

[Service]
ExecStart=/bin/sh -c 'exec /usr/bin/journalctl -u docker.service -f -o short-iso >> /var/log/docker.log'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now whoop-docker-daemon-log.service

tmp_dir="$(mktemp -d)"
curl -fsSL "https://s3.amazonaws.com/amazoncloudwatch-agent/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb" -o "$tmp_dir/amazon-cloudwatch-agent.deb"
dpkg -i "$tmp_dir/amazon-cloudwatch-agent.deb"
rm -rf "$tmp_dir"

cat >/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<EOF
{
  "agent": {
    "metrics_collection_interval": 60,
    "region": "$AWS_REGION",
    "logfile": "/opt/aws/amazon-cloudwatch-agent/logs/amazon-cloudwatch-agent.log"
  },
  "metrics": {
    "namespace": "CWAgent",
    "append_dimensions": {
      "InstanceId": "\$${aws:InstanceId}",
      "InstanceType": "\$${aws:InstanceType}",
      "ImageId": "\$${aws:ImageId}"
    },
    "metrics_collected": {
      "cpu": {
        "measurement": ["usage_active"],
        "metrics_collection_interval": 60,
        "totalcpu": true
      },
      "disk": {
        "measurement": ["used_percent"],
        "metrics_collection_interval": 60,
        "resources": ["/"]
      },
      "mem": {
        "measurement": ["used_percent"],
        "metrics_collection_interval": 60
      }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/syslog",
            "log_group_name": "$CLOUDWATCH_HOST_LOG_GROUP",
            "log_stream_name": "{instance_id}/syslog"
          },
          {
            "file_path": "/var/log/cloud-init.log",
            "log_group_name": "$CLOUDWATCH_HOST_LOG_GROUP",
            "log_stream_name": "{instance_id}/cloud-init"
          },
          {
            "file_path": "/var/log/cloud-init-output.log",
            "log_group_name": "$CLOUDWATCH_HOST_LOG_GROUP",
            "log_stream_name": "{instance_id}/cloud-init-output"
          },
          {
            "file_path": "/var/log/docker.log",
            "log_group_name": "$CLOUDWATCH_HOST_LOG_GROUP",
            "log_stream_name": "{instance_id}/docker-daemon"
          },
          {
            "file_path": "/var/log/whoop-ai-coach/deploy.log",
            "log_group_name": "$CLOUDWATCH_HOST_LOG_GROUP",
            "log_stream_name": "{instance_id}/deploy"
          }
        ]
      }
    }
  }
}
EOF

/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config \
  -m ec2 \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json \
  -s

mkdir -p "$APP_DIRECTORY"
chown ubuntu:ubuntu "$APP_DIRECTORY"
