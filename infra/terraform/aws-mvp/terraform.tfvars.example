aws_region              = "us-east-1"
project_name            = "whoop-ai-coach"
environment             = "prod"
domain_name             = "app.example.com"
cloudflare_zone_name    = "example.com"
cloudflare_record_name  = "app"
github_repository       = "JakubSu/WHOOP"
github_actions_environment = "production"
ec2_key_pair_name       = "your-ec2-keypair"
allowed_ssh_cidr_blocks = ["203.0.113.10/32"]
cloudwatch_log_retention_days = 30

# Store real values outside source control. These values are written to SSM
# Parameter Store as SecureString parameters during terraform apply.
cloudflare_api_token        = "replace-me"
django_secret_key           = "replace-me"
openai_api_key              = "replace-me"
whoop_client_id             = "replace-me"
whoop_client_secret         = "replace-me"
whoop_token_encryption_key  = "replace-me"
postgres_password           = "replace-me"

tags = {
  Owner = "platform"
}
