APP_DOMAIN=app-aicoach.jakubsuran.com
DJANGO_ENV=production
CADDY_ACME_EMAIL=admin@example.com
AWS_REGION=us-east-1
SSM_PARAMETER_PREFIX=/whoop-ai-coach/prod
CLOUDWATCH_LOG_GROUP=/whoop-ai-coach/prod/docker
# Validation-only placeholders. The deployment bootstrap replaces these with
# values from SSM; never use these values in a running production environment.
SECRET_KEY=replace-with-a-long-random-django-secret
OPENAI_API_KEY=replace-me
LOGFIRE_TOKEN=replace-me
WHOOP_CLIENT_ID=replace-me
WHOOP_CLIENT_SECRET=replace-me
WHOOP_TOKEN_ENCRYPTION_KEY=replace-me
WHOOP_ACCESS_ALLOWLIST=friend1@example.com,friend2@example.com
SES_FROM_EMAIL=verified-sender@example.com
WHOOP_ACCESS_REQUEST_ADMIN_EMAIL=kuba.suran.15@gmail.com
POSTGRES_PASSWORD=replace-me
OPENAI_MODEL=gpt-5.6-luna
LOG_LEVEL=INFO
WEB_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/whoop-ai-coach/web@sha256:replace-me
API_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/whoop-ai-coach/api@sha256:replace-me
